# ── Bifrost gateway (title partner — all model calls route through it) ──
# OpenAI-compatible endpoint of a running Bifrost instance.
# Local:  npx @maximhq/bifrost  →  http://localhost:8080/v1
BIFROST_BASE_URL=http://localhost:8080/v1
# Bifrost virtual/governance key (if Bifrost auth is enabled). Optional.
BIFROST_API_KEY=
# Model in Bifrost's `provider/model` form.
BRIEF_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# ── Direct fallback (OpenAI-compatible, used only when Bifrost is absent) ──
# Point these straight at the provider to bypass the gateway (dev only).
LLM_BASE_URL=
LLM_API_KEY=

# ── Tavily (track partner — the 30-day research sweep) ──
# Bearer-auth key from app.tavily.com
TAVILY_API_KEY=

# ── Kane CLI (verification layer — real-browser audits of finished briefs) ──
# POST /api/verify shells out to `kane-cli run --agent --headless` on the
# host running this app. Needs kane-cli installed + logged in and Chrome.
# KANE_VERIFY=off disables the verify endpoint entirely.
# KANE_CLI_BIN=           # override the binary path (default: kane-cli on PATH)
# KANE_CHROME_PROFILE=    # dedicated Chrome user-data-dir (default: ~/.doorknock/kane-chrome-profile)
# KANE_TARGET_ORIGIN=     # origin Kane opens, e.g. https://doorknock.example.com
# KANE_POLICY=            # evidence-pack policy YAML (default: ./kane/policy.yaml;
#                         # set empty to skip policy judgement)
# KANE_AUTO_VERIFY=       # "off" disables auto-verification when a brief
#                         # finishes; default on wherever kane-cli exists
#                         # (the app probes the binary once — hosts without
#                         # it, e.g. Render, report verification unavailable)
# DOORKNOCK_SABOTAGE=     # demo affordance: "strip-source-links" removes every
#                         # development's source links from finished briefs so
#                         # Kane CLI catches a real defect and FIXER repairs it.
KANE_VERIFY=
DOORKNOCK_SABOTAGE=
