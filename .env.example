# ── Bifrost gateway (title partner — all model calls route through it) ──
# OpenAI-compatible endpoint of a running Bifrost instance.
# Local:  npx @maximhq/bifrost  →  http://localhost:8080/v1
BIFROST_BASE_URL=http://localhost:8080/v1
# Bifrost virtual/governance key (if Bifrost auth is enabled). Optional.
BIFROST_API_KEY=
# Model in Bifrost's `provider/model` form.
BRIEF_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# ── Direct fallback (OpenAI-compatible, used only when Bifrost is absent) ──
# Point these straight at the provider to bypass the gateway (dev only).
LLM_BASE_URL=
LLM_API_KEY=

# ── Tavily (track partner — the 30-day research sweep) ──
# Bearer-auth key from app.tavily.com
TAVILY_API_KEY=
